# Copy this file to .env before starting Docker Compose.
# Replace every placeholder with a unique, strong value before any non-local deployment.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
AI_INTERNAL_API_KEY=replace-with-a-long-random-service-to-service-secret
NODE_ENV=production
CORS_ORIGIN=https://saferoads.yourdomain.com
VITE_API_BASE_URL=https://api.yourdomain.com/api
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="SafeRoad" <noreply@yourdomain.com>
