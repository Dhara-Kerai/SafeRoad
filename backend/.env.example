# SafeRoad Backend Environment Configuration

# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:replace-with-the-same-strong-local-password@localhost:5432/saferoad?schema=public"

# Password used by backend/docker-compose.yml for the local PostgreSQL container.
# Replace with a strong local value; never use this example value outside local development.
POSTGRES_PASSWORD="replace-with-a-strong-local-database-password"

# Secret key for JWT generation and verification
# IMPORTANT: Generate a strong secret key in production.
# Example command: openssl rand -base64 32  OR  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_YOUR_SECURE_RANDOM_SECRET_KEY_HERE"

# Application Server Port (Default: 8000)
PORT=8000

# AI Microservice URL for computer vision detection
AI_SERVICE_URL="http://localhost:8001"

# Shared secret key for internal AI service authentication
AI_INTERNAL_API_KEY="replace-with-a-long-random-service-to-service-secret"

# Allowed CORS origins (comma-separated for multiple origins)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Node environment (development | production | test)
NODE_ENV="development"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="\"SafeRoad\" <your-email@example.com>"
