generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(uuid())
  fullName            String
  email               String          @unique
  password            String
  role                Role            @default(USER)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  comments            Comment[]
  notifications       Notification[]
  officer             Officer?
  passwordResets      PasswordReset[]
  refreshTokens       RefreshToken[]
  reports             Report[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
  @@map("refresh_tokens")
}

model PasswordReset {
  id             String    @id @default(uuid())
  userId         String
  otpHash        String
  resetTokenHash String?
  expiresAt      DateTime
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  officers  Officer[]
  reports   Report[]

  @@map("departments")
}

model Officer {
  id           String     @id @default(uuid())
  userId       String     @unique
  departmentId String
  badgeNumber  String     @unique
  status       String     @default("Available")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports      Report[]

  @@map("officers")
}

model Report {
  id            String         @id @default(uuid())
  userId        String
  title         String
  description   String
  latitude      Float
  longitude     Float
  address       String
  city          String
  status        ReportStatus   @default(REPORTED)
  severity      Severity       @default(MEDIUM)
  departmentId  String?
  officerId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  aiResults     AIResult[]
  attachments   Attachment[]
  comments      Comment[]
  notifications Notification[]
  department    Department?    @relation(fields: [departmentId], references: [id])
  officer       Officer?       @relation(fields: [officerId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([departmentId])
  @@index([officerId])
  @@map("reports")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  reportId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reportId])
  @@map("comments")
}

model Attachment {
  id        String   @id @default(uuid())
  reportId  String
  url       String
  fileType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("attachments")
}

model AIResult {
  id              String   @id @default(uuid())
  reportId        String
  potholeDetected Boolean
  confidenceScore Float
  details         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("ai_results")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(REPORT)
  read      Boolean          @default(false)
  reportId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  report    Report?          @relation(fields: [reportId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

enum Role {
  USER
  OFFICER
  ADMIN
}

enum ReportStatus {
  REPORTED
  AI_VERIFIED
  OFFICER_ASSIGNED
  IN_PROGRESS
  FIXED
  QUALITY_CHECK
  COMPLETED
  CLOSED
  REJECTED
  NEEDS_REVIEW
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  REPORT
  WARNING
  SUCCESS
  ADMIN
  ASSIGNMENT
}
